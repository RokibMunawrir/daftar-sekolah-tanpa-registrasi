---
import Panel from "../ui/panel.astro";
import db from "../../../db";
import { tahunAjaran, santri, pendaftaran } from "../../../db/schema";
import { count, eq } from "drizzle-orm";

// Fetch real data
let academicYears: any[] = [];
let totalSantri = 0;
let activeYear: any = null;
let ppdbYear: any = null;

try {
  academicYears = await db.select().from(tahunAjaran).orderBy(tahunAjaran.tahun);
  const [countRow] = await db.select({ total: count() }).from(santri);
  totalSantri = countRow?.total || 0;
  activeYear = academicYears.find(y => y.isActive === 1) || null;
  ppdbYear = academicYears.find(y => y.isOpenPpdb === 1) || null;
} catch(e) {
  console.error('Years DB error:', e);
}
---


<Panel activeMenu="setting-tahun-ajaran">
  <div class="space-y-8 pb-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white bg-gradient-to-r from-indigo-600 to-violet-500 bg-clip-text text-transparent">Pengaturan Tahun Ajaran</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-1">
          Kelola tahun akademik pembelajaran dan status penerimaan siswa baru (PPDB).
        </p>
      </div>
      <div>
        <button id="add-year-btn" class="flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white px-6 py-3 rounded-2xl font-bold text-sm transition-all shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 cursor-pointer transform hover:-translate-y-0.5 duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Tambah Tahun Ajaran
        </button>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="bg-gradient-to-br from-indigo-600 to-indigo-700 dark:from-indigo-950/60 dark:to-slate-900/40 p-6 rounded-3xl border border-indigo-200/20 dark:border-indigo-800/20 shadow-xl shadow-indigo-100/30 dark:shadow-none text-white">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-indigo-100">Tahun Ajaran Aktif</span>
          <span class="p-2 bg-white/10 rounded-xl"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-100"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5z"/><path d="M6 18h14"/><path d="M12 6l3.5 3.5L12 13"/><path d="M15.5 9.5H8"/></svg></span>
        </div>
        <p class="text-3xl font-black mt-4 tracking-tight" id="stat-active-year">{activeYear?.tahun || 'Belum Ada'}</p>
        <span class="inline-flex items-center gap-1.5 mt-2 text-xs font-bold px-3 py-1 bg-white/20 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Sedang Berjalan
        </span>
      </div>

      <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl shadow-slate-100/30 dark:shadow-none">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-slate-500 dark:text-slate-400">Penerimaan PPDB</span>
          <span class="p-2 bg-indigo-50 dark:bg-slate-800 rounded-xl text-indigo-600 dark:text-indigo-400"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        </div>
        <p class="text-3xl font-black mt-4 text-slate-900 dark:text-white tracking-tight" id="stat-ppdb-status">{ppdbYear ? 'Terbuka' : 'Ditutup'}</p>
        <span class="inline-flex items-center gap-1.5 mt-2 text-xs font-bold text-indigo-600 dark:text-indigo-400">
          {ppdbYear ? `T.A. ${ppdbYear.tahun}` : 'Belum ada PPDB aktif'}
        </span>
      </div>

      <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl shadow-slate-100/30 dark:shadow-none">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-slate-500 dark:text-slate-400">Total Siswa Terdata</span>
          <span class="p-2 bg-indigo-50 dark:bg-slate-800 rounded-xl text-indigo-600 dark:text-indigo-400"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/></svg></span>
        </div>
        <p class="text-3xl font-black mt-4 text-slate-900 dark:text-white tracking-tight">{totalSantri.toLocaleString('id-ID')}</p>
        <span class="inline-flex items-center gap-1.5 mt-2 text-xs font-semibold text-slate-400 dark:text-slate-500">
          Akumulasi seluruh tahun
        </span>
      </div>
    </div>

    <!-- Main Content Table -->
    <div class="bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-200/20 dark:shadow-none overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[650px]">
          <thead>
            <tr class="bg-slate-50/60 dark:bg-slate-800/40 border-b border-slate-200 dark:border-slate-800">
              <th class="px-6 py-5 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                Tahun Ajaran
              </th>
              <th class="px-6 py-5 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline mr-1"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Kapasitas Siswa
              </th>
              <th class="px-6 py-5 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Status Pembelajaran</th>
              <th class="px-6 py-5 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Penerimaan (PPDB)</th>
              <th class="px-6 py-5 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50" id="years-table-body">
            {academicYears.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                  <p class="font-medium">Belum ada tahun ajaran. Tambahkan melalui tombol di atas.</p>
                </td>
              </tr>
            ) : academicYears.map((item) => (
              <tr class="hover:bg-indigo-50/10 dark:hover:bg-slate-800/20 transition-all duration-200 group" data-id={item.id}>
                <!-- Tahun Ajaran -->
                <td class="px-6 py-5 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center flex-shrink-0 font-bold text-sm border border-indigo-100 dark:border-indigo-900/30 group-hover:scale-105 transition-all">
                      {item.tahun.substring(2,4)}
                    </div>
                    <span class="font-extrabold text-slate-800 dark:text-slate-200 text-base">{item.tahun}</span>
                  </div>
                </td>
                
                <!-- Kapasitas / Siswa -->
                <td class="px-6 py-5 whitespace-nowrap">
                  <div class="flex flex-col gap-1.5">
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-extrabold text-slate-800 dark:text-slate-200">0</span>
                      <span class="text-xs text-slate-400 dark:text-slate-500">/ {item.kuota || 350} Terisi</span>
                    </div>
                    <div class="w-32 h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden hidden sm:block">
                      <div 
                        class="h-full bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full transition-all duration-500" 
                        style="width: 0%"
                      ></div>
                    </div>
                  </div>
                </td>

                <!-- Status Pembelajaran -->
                <td class="px-6 py-5 whitespace-nowrap">
                  {item.isActive === 1 ? (
                    <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-extrabold bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                      Aktif Berjalan
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-extrabold bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700/50">
                      Tidak Aktif
                    </span>
                  )}
                </td>

                <!-- PPDB Toggle -->
                <td class="px-6 py-5 whitespace-nowrap">
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="sr-only peer ppdb-toggle" data-id={item.id} checked={item.isOpenPpdb === 1}>
                    <div class="w-12 h-6.5 bg-slate-200 dark:bg-slate-800 rounded-full peer peer-checked:after:translate-x-5.5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[3px] after:left-[3px] after:bg-white after:border-slate-300 dark:after:bg-slate-400 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:after:border-slate-700 peer-checked:bg-gradient-to-r peer-checked:from-indigo-600 peer-checked:to-violet-600 shadow-sm"></div>
                    <span class="ml-3 text-xs font-bold text-slate-400 dark:text-slate-500 peer-checked:text-indigo-600 dark:peer-checked:text-indigo-400 transition-colors">
                      {item.isOpenPpdb === 1 ? 'Dibuka' : 'Ditutup'}
                    </span>
                  </label>
                </td>

                <!-- Aksi -->
                <td class="px-6 py-5 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end gap-3">
                    {item.isActive !== 1 && (
                      <button class="px-3.5 py-2 text-xs font-extrabold rounded-xl border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-600/30 dark:hover:border-indigo-400/30 transition-all duration-200 cursor-pointer set-active-btn" data-id={item.id}>
                        Set Aktif
                      </button>
                    )}
                    <button class="p-2 text-slate-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl transition-all duration-200 cursor-pointer delete-year-btn" data-id={item.id} title="Hapus">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Tambah Tahun Ajaran -->
  <div id="add-modal" class="fixed inset-0 bg-slate-950/40 backdrop-blur-[2px] flex items-center justify-center p-4 z-50 hidden opacity-0 transition-all duration-300">
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl w-full max-w-md shadow-2xl p-6 scale-95 transition-all duration-300" id="modal-panel">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Tambah Tahun Ajaran</h3>
        <button type="button" id="close-modal-x" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      
      <form id="add-year-form" class="space-y-4">
        <div class="space-y-2">
          <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Format Tahun Ajaran</label>
          <input 
            type="text" 
            id="new-year-input"
            placeholder="Contoh: 2027/2028"
            class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm font-bold"
            required
          />
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" id="close-modal-btn" class="px-4 py-2.5 rounded-xl font-bold text-sm border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all cursor-pointer">
            Batal
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl font-bold text-sm bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white transition-all shadow-md cursor-pointer">
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div>
</Panel>

<script>
  // Modal logic
  const modal = document.getElementById('add-modal');
  const modalPanel = document.getElementById('modal-panel');
  const addBtn = document.getElementById('add-year-btn');
  const closeBtn = document.getElementById('close-modal-btn');
  const closeX = document.getElementById('close-modal-x');

  const openModal = () => {
    modal?.classList.remove('hidden');
    setTimeout(() => {
      modal?.classList.add('opacity-100');
      modalPanel?.classList.add('scale-100');
    }, 50);
  };

  const closeModal = () => {
    modal?.classList.remove('opacity-100');
    modalPanel?.classList.remove('scale-100');
    setTimeout(() => {
      modal?.classList.add('hidden');
    }, 300);
  };

  addBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  closeX?.addEventListener('click', closeModal);

  // Toggle & Set Active - connected to API
  const attachTableListeners = () => {
    // Delete year
    document.querySelectorAll('.delete-year-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const row = (e.currentTarget as HTMLElement).closest('tr');
        if (!id) return;

        (window as any).showConfirmModal({
          title: 'Hapus Tahun Ajaran',
          type: 'delete',
          message: 'Apakah Anda yakin ingin menghapus tahun ajaran ini?',
          onConfirm: async () => {
            const res = await fetch('/api/admin/tahun-ajaran', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: parseInt(id) }),
            });
            if (res.ok) {
              row?.remove();
            } else {
              alert('Gagal menghapus tahun ajaran.');
            }
          }
        });
      });
    });

    // Toggle PPDB
    document.querySelectorAll('.ppdb-toggle').forEach(input => {
      input.addEventListener('change', async (e) => {
        const target = e.target as HTMLInputElement;
        const id = target.dataset.id;
        if (!id) return;
        const textNode = target.closest('label')?.querySelector('span');

        const res = await fetch('/api/admin/tahun-ajaran', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(id), action: 'toggle-ppdb', value: target.checked }),
        });

        if (res.ok) {
          if (textNode) textNode.textContent = target.checked ? 'Dibuka' : 'Ditutup';
          const ppdbStat = document.getElementById('stat-ppdb-status');
          if (ppdbStat) ppdbStat.textContent = target.checked ? 'Terbuka' : 'Ditutup';
        } else {
          target.checked = !target.checked; // revert
          alert('Gagal mengubah status PPDB.');
        }
      });
    });

    // Set Active
    document.querySelectorAll('.set-active-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        if (!id) return;

        const res = await fetch('/api/admin/tahun-ajaran', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(id), action: 'set-active' }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal mengaktifkan tahun ajaran.');
        }
      });
    });
  };
  attachTableListeners();

  // Add Year Form Submit - connected to API
  const form = document.getElementById('add-year-form');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('new-year-input') as HTMLInputElement;
    if (!input) return;

    const tahun = input.value.trim();
    if (!tahun || !/^\d{4}\/\d{4}$/.test(tahun)) {
      alert('Format tahun ajaran tidak valid. Gunakan format YYYY/YYYY, contoh: 2027/2028');
      return;
    }

    const res = await fetch('/api/admin/tahun-ajaran', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tahun }),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      alert('Gagal menambah tahun ajaran: ' + (data.error || 'Unknown error'));
    }
  });
</script>

