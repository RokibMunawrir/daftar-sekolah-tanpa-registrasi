---
import Panel from "../ui/panel.astro";
import db from "../../../db";
import { santri, pendaftaran, pendidikanSebelumnya, alamat } from "../../../db/schema";
import { count, eq, desc, like, or, sql } from "drizzle-orm";

const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1');
const pageSize = 10;
const search = url.searchParams.get('search') || '';
const offset = (page - 1) * pageSize;

// Fetch data from database
let data: any[] = [];
let total = 0;
let totalPages = 1;
let visiblePages: number[] = [];

try {
  // Total count
  const [countRow] = await db.select({ total: count() }).from(santri);
  total = countRow?.total || 0;
  totalPages = Math.ceil(total / pageSize);

  // Pagination logic (moved to frontmatter to avoid Astro JSX parser issues with '<')
  const maxVisible = 5;
  let startPage = 1;
  if (totalPages <= maxVisible) {
    startPage = 1;
  } else if (page <= 3) {
    startPage = 1;
  } else if (page >= totalPages - 2) {
    startPage = totalPages - 4;
  } else {
    startPage = page - 2;
  }
  for (let i = 0; i < Math.min(totalPages, maxVisible); i++) {
    visiblePages.push(startPage + i);
  }



  // Paginated data with joins
  data = await db
    .select({
      id: santri.id,
      nisn: santri.nisn,
      namaLengkap: santri.namaLengkap,
      namaSekolah: pendidikanSebelumnya.namaSekolah,
      nomorHpOrangTua: alamat.nomorHpOrangTua,
      jenjangPendaftaran: pendaftaran.jenjangPendaftaran,
      kategoriPendaftaran: pendaftaran.kategoriPendaftaran,
      statusSantri: pendaftaran.statusSantri,
      createdAt: santri.createdAt,
    })
    .from(santri)
    .leftJoin(pendidikanSebelumnya, eq(pendidikanSebelumnya.santriId, santri.id))
    .leftJoin(alamat, eq(alamat.santriId, santri.id))
    .leftJoin(pendaftaran, eq(pendaftaran.santriId, santri.id))
    .orderBy(desc(santri.createdAt))
    .limit(pageSize)
    .offset(offset);
} catch (e) {
  console.error('List DB error:', e);
}

// Calculate range
const startItem = total === 0 ? 0 : offset + 1;
const endItem = Math.min(offset + pageSize, total);

// Helper to format phone number to international format for WhatsApp
const formatWhatsApp = (phone: string) => {
  if (!phone) return '#';
  let cleaned = phone.replace(/\D/g, '');
  if (cleaned.startsWith('0')) {
    cleaned = '62' + cleaned.substring(1);
  }
  return `https://wa.me/${cleaned}`;
};

// Format date
const formatDate = (date: Date | string | null) => {
  if (!date) return '-';
  return new Date(date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
};
---

<Panel activeMenu="pendaftar">
  <div class="space-y-6 pb-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Daftar Calon Siswa</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-1">
          Menampilkan total <span class="font-semibold text-indigo-600 dark:text-indigo-400">{total}</span> calon siswa terdaftar.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/admin/pendaftar/tambah" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-all shadow-lg shadow-indigo-500/20 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Tambah Santri
        </a>
        <a href={`/api/admin/export-pendaftar`} class="flex items-center gap-2 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 px-5 py-2.5 rounded-xl font-semibold text-sm transition-all cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Unduh Data
        </a>
      </div>
    </div>

    <!-- Filter and Search Bar -->
    <form method="get" class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col md:flex-row gap-3 items-center justify-start">
      <div class="relative w-full md:w-96">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400 dark:text-slate-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input 
          type="text" 
          name="search"
          id="search-input"
          value={search}
          placeholder="Cari nama atau NISN..." 
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-sm"
        />
      </div>
      <button type="submit" class="w-full md:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold text-sm transition-all shadow-md shadow-indigo-500/10 cursor-pointer">
        Cari
      </button>
    </form>

    <!-- Data Table Card -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left" id="siswa-table">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800">
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">No.</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Nama Calon Siswa</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">NISN</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Asal Sekolah</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Jenjang</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">No. HP</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Tanggal Daftar</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="table-body">
            {data.length === 0 ? (
              <tr>
                <td colspan="9" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">
                  <div class="flex flex-col items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 dark:text-slate-600 mb-3"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                    <p class="font-medium text-base">Tidak ada data calon siswa</p>
                    <p class="text-xs text-slate-400 mt-1">{search ? 'Tidak ada hasil untuk pencarian ini.' : 'Belum ada pendaftar. Bagikan link pendaftaran ke calon siswa.'}</p>
                  </div>
                </td>
              </tr>
            ) : (
              data.map((item, index) => (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                  <td class="px-6 py-4 text-sm font-medium text-slate-400 dark:text-slate-600">
                    {startItem + index}
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center text-indigo-700 dark:text-indigo-300 font-bold text-xs shadow-inner">
                        {item.namaLengkap.split(' ').map((n: string) => n[0]).join('').substring(0,2).toUpperCase()}
                      </div>
                      <div>
                        <div class="font-semibold text-slate-900 dark:text-white">{item.namaLengkap}</div>
                        <div class="text-[10px] font-medium text-slate-400 dark:text-slate-500 mt-0.5">{item.kategoriPendaftaran || 'Reguler'}</div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">
                    {item.nisn || '-'}
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">
                    {item.namaSekolah || '-'}
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-400">
                      {item.jenjangPendaftaran || '-'}
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full ${
                      item.statusSantri === 'Baru' 
                        ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300'
                        : 'bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-300'
                    }`}>
                      {item.statusSantri || 'Baru'}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm">
                    {item.nomorHpOrangTua ? (
                      <a 
                        href={formatWhatsApp(item.nomorHpOrangTua)} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="flex items-center gap-1.5 text-indigo-600 dark:text-indigo-400 hover:underline font-medium"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        {item.nomorHpOrangTua}
                      </a>
                    ) : (
                      <span class="text-slate-400">-</span>
                    )}
                  </td>
                  <td class="px-6 py-4 text-xs text-slate-500 dark:text-slate-400">
                    {formatDate(item.createdAt)}
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a 
                        href={`/admin/pendaftar/detail/${item.id}`}
                        class="p-2 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800"
                        title="Detail"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                      </a>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      {total > 0 && (
        <div class="px-6 py-4 bg-slate-50/50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-sm text-slate-500 dark:text-slate-400">
            Menampilkan <span class="font-semibold text-slate-900 dark:text-white">{startItem}</span> sampai <span class="font-semibold text-slate-900 dark:text-white">{endItem}</span> dari <span class="font-semibold text-slate-900 dark:text-white">{total}</span> entri
          </div>
          
          <div class="flex items-center gap-2">
            <a
              href={`?page=${Math.max(1, page - 1)}${search ? `&search=${search}` : ''}`}
              class={`flex items-center gap-1.5 px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-semibold transition-all ${
                page <= 1 
                  ? 'text-slate-300 dark:text-slate-700 pointer-events-none' 
                  : 'text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-900 shadow-sm'
              }`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              Sebelumnya
            </a>
            
            <div class="flex items-center gap-1">
              {visiblePages.map((p) => (
                <a
                  href={`?page=${p}${search ? `&search=${search}` : ''}`}
                  class={`w-9 h-9 flex items-center justify-center rounded-xl text-sm font-semibold transition-all ${
                    p === page
                      ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-500/20'
                      : 'text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-900 border border-transparent hover:border-slate-200 dark:hover:border-slate-800'
                  }`}
                >
                  {p}
                </a>
              ))}
            </div>



            <a
              href={`?page=${Math.min(totalPages, page + 1)}${search ? `&search=${search}` : ''}`}
              class={`flex items-center gap-1.5 px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-semibold transition-all ${
                page >= totalPages 
                  ? 'text-slate-300 dark:text-slate-700 pointer-events-none' 
                  : 'text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-900 shadow-sm'
              }`}
            >
              Berikutnya
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
</Panel>
