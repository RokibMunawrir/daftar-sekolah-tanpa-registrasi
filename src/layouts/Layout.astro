---
/* @jsxImportSource astro */
import "../styles/global.css";

const title = Astro.props.title || "PPDB Online 2026 | SMP IT Darussalam Luwuk";
const description = Astro.props.description || "Penerimaan Peserta Didik Baru (PPDB) Online | SMP IT Darussalam Luwuk";
const keyword = Astro.props.keyword || "PPDB Online 2026, SMP IT Darussalam Luwuk";
const author = Astro.props.author || "SMP IT Darussalam Luwuk";
const ogImage = Astro.props.ogImage || "/og-image.jpg";
const ogType = Astro.props.ogType || "website";
const canonical = Astro.props.canonical || Astro.url.href;
const ogTitle = Astro.props.ogTitle || title;
const ogDescription = Astro.props.ogDescription || description;
const schema = Astro.props.schema || {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": title,
  "url": canonical
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Dasar -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {keyword && <meta name="keywords" content={keyword} />}
    {author && <meta name="author" content={author} />}
    <meta name="robots" content="index,follow" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ffffff" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#020617"
    />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:site_name" content="PPDB Online 2026" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />

    <!-- URL Gambar HARUS absolut -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogTitle} />

    <!-- Legacy -->
    <link rel="image_src" href={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      document.documentElement.classList.toggle("dark", theme === "dark");
      document.documentElement.style.colorScheme = theme;
      window.localStorage.setItem("theme", theme);
    </script>
  </head>

  <body
    class="bg-white text-slate-900 transition-colors duration-300 dark:bg-slate-950 dark:text-slate-100"
  >
    <slot />
  </body>
</html>
